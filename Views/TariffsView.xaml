<UserControl x:Class="K2pVpnWindows.Views.TariffsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,6,20,20">
            <!-- Header + Refresh -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Тарифы и оплата" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Content="Обновить" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" FontSize="11" Click="OnRefreshClick"/>
            </Grid>

            <!-- Subscription Status Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="SubStatusTitle" Text="Подписка активна" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubStatusSubtitle" Text="Осталось: — дн." FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border x:Name="DiscountBadge" Grid.Column="1" Visibility="Collapsed"
                            Background="#3B111C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock x:Name="DiscountBadgeText" Text="-10%" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource AccentHoverBrush}" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Tariffs List -->
            <ItemsControl x:Name="TariffsListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="NoWrap"/>
                                        <Border Visibility="{Binding BadgeVisibility}" Background="#3B111C"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}" TextWrapping="NoWrap"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding PriceText}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentHoverBrush}"/>
                                        <TextBlock Text="{Binding OldPriceText}" Visibility="{Binding OldPriceVisibility}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextDecorations="Strikethrough" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Оплатить" Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,9" FontSize="12" VerticalAlignment="Center"
                                        Click="OnPayClick" Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TariffErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                       Foreground="#FCA5A5" Margin="0,4,0,8"/>

            <!-- Offer Link -->
            <Button Content="Публичная оферта и условия" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,6,0,0" Click="OnOpenOfferClick"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
