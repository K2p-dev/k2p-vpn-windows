<UserControl x:Class="K2pVpnWindows.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,4,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Central Power Button + Pulsing Glow -->
                <Grid x:Name="PowerContainer" Height="210" Margin="0,4,0,2">
                    <Ellipse x:Name="PulseRing" Width="188" Height="188" Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Button x:Name="ConnectBtn" Width="160" Height="160" Cursor="Hand" Click="OnConnectClick"
                            BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="OuterCircle" Fill="{DynamicResource CardBrush}"
                                             Stroke="{DynamicResource OutlineBrush}" StrokeThickness="2.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowEffect" Color="{DynamicResource AccentColor}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                            <Path x:Name="PowerIconPath"
                                                  Data="M 12,3 L 12,12 M 7.05,5.64 A 8,8 0 1 0 16.95,5.64"
                                                  Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}"
                                                  StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Rectangle x:Name="StopIconRect" Visibility="Collapsed"
                                                       Width="20" Height="20" RadiusX="4" RadiusY="4"
                                                       Fill="{DynamicResource AccentTextOnPageBrush}"/>
                                        </Grid>
                                        <TextBlock x:Name="PowerLabel" Text="ПОДКЛЮЧИТЬ" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Session Timer & Speed -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="DownSpeedText" Text="↓ 0.0 KB/s" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="UpSpeedText" Text="↑ 0.0 KB/s" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Mode Selector (Full mode) -->
                <Border x:Name="ModeSelectorCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="5" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TunModeBtn" Grid.Column="0" Content="TUN (Весь ПК и игры)" Click="OnTunModeClick"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="8,8" FontSize="12"/>
                        <Button x:Name="ProxyModeBtn" Grid.Column="1" Content="Системный прокси" Click="OnProxyModeClick"
                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,8" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Selected Location Card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Cursor="Hand" MouseLeftButtonUp="OnToggleServerListClick">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="22" Height="15" CornerRadius="3" ClipToBounds="True"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0.5">
                                <Image x:Name="SelectedFlagImage" Stretch="UniformToFill"
                                       Source="{Binding Source='DEFAULT', Converter={StaticResource CountryFlagConverter}}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedNameText" Text="Загрузка серверов..." FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedProtoText" Text="VLESS • REALITY" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CardVariantBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="SelectedPingText" Text="— ms" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                                <TextBlock x:Name="ChevronText" Text="▼" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ServerListPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Button Content="Пинг всех" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" FontSize="11" Click="OnPingAllClick"/>
                                <Button Content="Обновить подписку" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" FontSize="11" Click="OnRefreshSubClick"/>
                            </Grid>
                            <ItemsControl x:Name="ServersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardVariantBrush}" CornerRadius="10" Padding="10,7" Margin="0,0,0,5"
                                                Cursor="Hand" MouseLeftButtonUp="OnServerItemClick" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="20" Height="14" CornerRadius="3" ClipToBounds="True"
                                                        VerticalAlignment="Center" Margin="0,0,9,0"
                                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0.5">
                                                    <Image Stretch="UniformToFill"
                                                           Source="{Binding FlagKey, Converter={StaticResource CountryFlagConverter}}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProtocolLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PingDisplay}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick RF Bypass Toggle (shown in Compact Mode) -->
                <Border x:Name="CompactBypassCard" Visibility="Collapsed" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                        <TextBlock Text="Обход РФ (сайты и банки напрямую)" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CompactBypassSwitch" HorizontalAlignment="Right"
                                  Style="{StaticResource SwitchCheckBoxStyle}" Click="OnCompactBypassToggle"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusMessageText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                           Foreground="{DynamicResource ErrorTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TrafficInfoText" Grid.Row="1" Text="Трафик: —" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
