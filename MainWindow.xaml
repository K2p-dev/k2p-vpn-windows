<Window x:Class="K2pVpnWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:K2pVpnWindows.Views"
        Title="Как 2 пальца" Width="460" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1" CornerRadius="20" ClipToBounds="True">
        <Grid>
            <!-- Background Layer (Gradient / Static Image / Hardware Video) strictly clipped to CornerRadius -->
            <Border x:Name="BgContainer" CornerRadius="20" ClipToBounds="True">
                <Border.OpacityMask>
                    <VisualBrush Stretch="None">
                        <VisualBrush.Visual>
                            <Border Background="Black" CornerRadius="20"
                                    Width="{Binding ActualWidth, ElementName=BgContainer}"
                                    Height="{Binding ActualHeight, ElementName=BgContainer}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Grid>
                    <Border x:Name="BgGradientLayer" CornerRadius="20" Background="{DynamicResource AmbientGlowBrush}"/>
                    <Border x:Name="BgImageLayer" CornerRadius="20" Visibility="Collapsed"/>
                    <MediaElement x:Name="BgVideoLayer" Visibility="Collapsed" LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual" IsMuted="True" ScrubbingEnabled="False"
                                  Stretch="UniformToFill" MediaEnded="OnVideoMediaEnded"/>
                    <Border x:Name="BgDimOverlay" CornerRadius="20" Background="#000000" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Foreground UI -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (only HeaderBar handles DragMove) -->
                <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="/Assets/logo.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Как 2 пальца" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource CardVariantBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v0.2.10" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentTextOnPageBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border x:Name="StatusBadge" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock x:Name="StatusBadgeText" Text="Активна • — дн." FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextOnPageBrush}" TextWrapping="NoWrap"/>
                    </Border>

                    <!-- Window Controls: Compact/Full toggle, Minimize, Close-to-Tray -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="ModeToggleBtn" Content="◱" Width="28" Height="28" Click="OnToggleWindowModeClick"
                                ToolTip="Переключить компактный / полный режим"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="14" Cursor="Hand"/>
                        <Button Content="—" Width="28" Height="28" Click="OnMinimizeClick"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="13" Cursor="Hand"/>
                        <Button Content="✕" Width="28" Height="28" Click="OnCloseClick"
                                ToolTip="Свернуть в трей"
                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderThickness="0" FontSize="13" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- 4-Tab Navigation Bar (Full Mode when authenticated) -->
                <Border x:Name="NavBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="4" Margin="18,0,18,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NavMainBtn" Grid.Column="0" Content="VPN" Click="OnNavMainClick"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="6,7" FontSize="11"/>
                        <Button x:Name="NavTariffsBtn" Grid.Column="1" Content="Тарифы" Click="OnNavTariffsClick"
                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="6,7" FontSize="11"/>
                        <Button x:Name="NavProfileBtn" Grid.Column="2" Content="Профиль" Click="OnNavProfileClick"
                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="6,7" FontSize="11"/>
                        <Button x:Name="NavSettingsBtn" Grid.Column="3" Content="Настройки" Click="OnNavSettingsClick"
                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="6,7" FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Active Screen Host -->
                <Grid Grid.Row="2">
                    <views:AuthView x:Name="AuthScreen" Visibility="Visible"/>
                    <views:MainView x:Name="MainScreen" Visibility="Collapsed"/>
                    <views:TariffsView x:Name="TariffsScreen" Visibility="Collapsed"/>
                    <views:ProfileView x:Name="ProfileScreen" Visibility="Collapsed"/>
                    <views:SettingsView x:Name="SettingsScreen" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
