<UserControl x:Class="K2pVpnWindows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:K2pVpnWindows.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,6,20,20">
            <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <!-- Russia Geodata Bypass Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Авто-геоданные РФ" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Российские сайты, банки и Госуслуги работают напрямую без VPN" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="BypassRussiaSwitch" Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                  VerticalAlignment="Center" Click="OnBypassRussiaToggle"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,10"/>
                    <Grid>
                        <TextBlock x:Name="GeodataDateText" Text="База геоданных: Встроенная" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="UpdateGeodataBtn" Content="Обновить" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11"
                                Click="OnUpdateGeodataClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Routing Exclusions Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Исключения маршрутизации (напрямую)" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Домены или IP/CIDR через запятую или с новой строки (идут мимо VPN)" TextWrapping="Wrap"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                    <TextBox x:Name="ExclusionsBox" Style="{StaticResource DarkTextBoxStyle}" Height="58"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                    <Button Content="Сохранить исключения" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,7" FontSize="11" HorizontalAlignment="Right" Click="OnSaveExclusionsClick"/>
                </StackPanel>
            </Border>

            <!-- Appearance: Theme, Accent, Background & Video Wallpaper -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Оформление" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Тема" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ThemeDarkBtn" Grid.Column="0" Content="Тёмная" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnThemeDarkClick"/>
                        <Button x:Name="ThemeLightBtn" Grid.Column="2" Content="Светлая" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnThemeLightClick"/>
                        <Button x:Name="ThemeSystemBtn" Grid.Column="4" Content="Система" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnThemeSystemClick"/>
                    </Grid>

                    <TextBlock Text="Цветовой акцент" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AccentBrandBtn" Grid.Column="0" Content="Малиновый" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnAccentBrandClick"/>
                        <Button x:Name="AccentWinBtn" Grid.Column="2" Content="Windows" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnAccentWinClick"/>
                        <Button x:Name="AccentCustomBtn" Grid.Column="4" Content="Свой" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnAccentCustomClick"/>
                    </Grid>
                    <Border x:Name="CustomHexPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <controls:ColorPickerControl x:Name="AccentColorPicker" ColorChanged="OnVisualColorPicked"/>
                    </Border>

                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,4,0,10"/>

                    <TextBlock Text="Фон приложения" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BgGradientBtn" Grid.Column="0" Content="Градиент" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnBgGradientClick"/>
                        <Button x:Name="BgImageBtn" Grid.Column="2" Content="Фото" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="11" Click="OnBgImageClick"/>
                        <Button x:Name="BgVideoBtn" Grid.Column="4" Content="Видео (Эксп.)" Style="{StaticResource SecondaryButtonStyle}" Padding="6,6" FontSize="10" Click="OnBgVideoClick"/>
                    </Grid>

                    <StackPanel x:Name="MediaBgControls" Visibility="Collapsed">
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="MediaFileNameText" Text="Файл не выбран" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Button Content="Выбрать файл" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,5" FontSize="11" Click="OnPickMediaFileClick"/>
                        </Grid>
                        <TextBlock Text="Затемнение подложки" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <Slider x:Name="DimOpacitySlider" Minimum="0.2" Maximum="0.95" TickFrequency="0.05"
                                ValueChanged="OnDimSliderChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Windows Behavior Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Автозапуск вместе с Windows" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Запускать клиент свёрнутым в трей при входе" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                  VerticalAlignment="Center" Click="OnAutoStartToggle"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Сворачивать в системный трей" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="При закрытии окна VPN продолжает работать в фоне" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeTraySwitch" Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                  VerticalAlignment="Center" Click="OnMinimizeTrayToggle"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Version & GitHub Updates Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Версия приложения" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="VersionText" Text="v0.2.11 BETA" FontSize="12"
                               Foreground="{DynamicResource AccentTextOnPageBrush}" Margin="0,2,0,10"/>
                    <Button x:Name="CheckUpdatesBtn" Content="Проверить обновления на GitHub"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnCheckUpdatesClick" Margin="0,0,0,8"/>
                    <Button Content="Дебаг и логи подключения"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenDebugLogsClick"/>
                    <TextBlock x:Name="UpdateStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
