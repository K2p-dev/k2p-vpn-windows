<UserControl x:Class="K2pVpnWindows.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,6,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Central Power Button + Pulsing Glow -->
                <Grid Height="220" Margin="0,6,0,4">
                    <!-- Outer Pulsing Halo -->
                    <Ellipse x:Name="PulseRing" Width="194" Height="194" Stroke="{StaticResource AccentBrush}"
                             StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Main Circular Connect Button -->
                    <Button x:Name="ConnectBtn" Width="166" Height="166" Cursor="Hand" Click="OnConnectClick"
                            BorderThickness="0" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="OuterCircle" Fill="{StaticResource CardBrush}"
                                             Stroke="{StaticResource OutlineBrush}" StrokeThickness="2.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="GlowEffect" Color="#E11D48" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="PowerIcon" Text="⏻" FontSize="44" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PowerLabel" Text="ПОДКЛЮЧИТЬ" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Session Timer & Speed -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock x:Name="DownSpeedText" Text="↓ 0.0 KB/s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="UpSpeedText" Text="↑ 0.0 KB/s" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Mode Selector (TUN vs System Proxy) -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="5" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TunModeBtn" Grid.Column="0" Content="TUN (Весь ПК и игры)" Click="OnTunModeClick"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="8,9" FontSize="12"/>
                        <Button x:Name="ProxyModeBtn" Grid.Column="1" Content="Системный прокси" Click="OnProxyModeClick"
                                Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,9" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Selected Location Card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Cursor="Hand" MouseLeftButtonUp="OnToggleServerListClick">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedFlagText" Grid.Column="0" Text="🌐" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedNameText" Text="Загрузка серверов..." FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedProtoText" Text="VLESS • REALITY" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource CardVariantBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="SelectedPingText" Text="— ms" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                                <TextBlock x:Name="ChevronText" Text="▼" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Expandable Server List -->
                        <StackPanel x:Name="ServerListPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0">
                            <Border Height="1" Background="{StaticResource OutlineBrush}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Button Content="Пинг всех" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" FontSize="11" Click="OnPingAllClick"/>
                                <Button Content="Обновить подписку" HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" FontSize="11" Click="OnRefreshSubClick"/>
                            </Grid>
                            <ItemsControl x:Name="ServersItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardVariantBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,6"
                                                Cursor="Hand" MouseLeftButtonUp="OnServerItemClick" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FlagEmoji}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProtocolLabel}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PingDisplay}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status / Error Message -->
                <TextBlock x:Name="StatusMessageText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                           Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Traffic Footer -->
        <TextBlock x:Name="TrafficInfoText" Grid.Row="1" Text="Трафик: —" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
