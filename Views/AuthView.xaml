<UserControl x:Class="K2pVpnWindows.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,12,22,22">
            <!-- Brand Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="54" Height="54" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Как 2 пальца • BETA" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,2"/>
                <TextBlock Text="Два движения. Ноль проблем." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Main Auth Card (matching Android AuthScreen: Вход / Регистрация) -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                <StackPanel>
                    <!-- Mode Tabs: Вход | Регистрация -->
                    <Border Background="{DynamicResource CardVariantBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TabLoginBtn" Grid.Column="0" Content="Вход" Click="OnTabLoginClick"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="8,8" FontSize="13"/>
                            <Button x:Name="TabRegisterBtn" Grid.Column="1" Content="Регистрация" Click="OnTabRegisterClick"
                                    Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,8" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Error Banner -->
                    <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{DynamicResource ErrorBgBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorTextBrush}"/>
                    </Border>

                    <!-- LOGIN PANEL -->
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="LoginEmailBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Пароль" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource DarkPasswordBoxStyle}" Margin="0,0,0,16"
                                     PasswordChanged="OnLoginPasswordChanged"/>

                        <Button x:Name="EmailLoginBtn" Content="Войти" Style="{StaticResource PrimaryButtonStyle}" Click="OnEmailLoginClick"/>
                    </StackPanel>

                    <!-- REGISTER PANEL -->
                    <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                        <StackPanel x:Name="RegStep1Panel">
                            <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RegEmailBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Пароль" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="RegPasswordBox" Style="{StaticResource DarkPasswordBoxStyle}" Margin="0,0,0,16"
                                         PasswordChanged="OnRegPasswordChanged"/>

                            <Button x:Name="RegInitBtn" Content="Получить код на Email" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnRegInitClick"/>
                        </StackPanel>

                        <StackPanel x:Name="RegStep2Panel" Visibility="Collapsed">
                            <TextBlock Text="Мы отправили код подтверждения на ваш Email. Введите его ниже:"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            <TextBox x:Name="RegCodeBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,14"/>
                            <Button x:Name="RegVerifyBtn" Content="Подтвердить и войти" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnRegVerifyClick" Margin="0,0,0,8"/>
                            <Button Content="Назад" Style="{StaticResource SecondaryButtonStyle}" Click="OnRegBackClick"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Grid Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{DynamicResource OutlineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="или" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0"/>
                        <Border Grid.Column="2" Height="1" Background="{DynamicResource OutlineBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Telegram Quick Login -->
                    <Button x:Name="TgLoginBtn" Content="Войти через Telegram"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnTgLoginClick"/>
                    <TextBlock x:Name="TgPollingText" Visibility="Collapsed" Text="Ожидание подтверждения в @easyforeasy_bot..."
                               FontSize="12" Foreground="{DynamicResource AccentHoverBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Footer Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Telegram-бот" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"
                        Click="OnOpenBotClick"/>
                <Button Content="Поддержка" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7"
                        Click="OnOpenSupportClick"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
