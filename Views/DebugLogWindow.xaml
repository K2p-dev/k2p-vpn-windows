<Window x:Class="K2pVpnWindows.Views.DebugLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дебаг и логи подключения — Как 2 пальца" Width="760" Height="540"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Icon="/Assets/app.ico">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Category Filter Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="FilterAllBtn" Content="Все" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="ALL"/>
            <Button x:Name="FilterSingBoxBtn" Content="sing-box" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="SING-BOX"/>
            <Button x:Name="FilterXrayBtn" Content="Xray" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="XRAY"/>
            <Button x:Name="FilterTunBtn" Content="TUN" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="TUN"/>
            <Button x:Name="FilterRouteBtn" Content="Сеть / Маршруты" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="ROUTE"/>
            <Button x:Name="FilterPingBtn" Content="PING" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="PING"/>
            <Button x:Name="FilterOtaBtn" Content="OTA" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="OnFilterClick" Tag="OTA"/>
            <Button x:Name="FilterAppBtn" Content="APP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11" Click="OnFilterClick" Tag="APP"/>
        </StackPanel>

        <!-- Connection Test Banner -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <TextBlock x:Name="TestStatusText" Text="Нажмите «Тест соединения», чтобы проверить DNS и HTTP через локальный SOCKS5-порт Xray."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <Button x:Name="TestConnBtn" Content="Тест соединения (curl/DNS)" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontSize="11" Click="OnTestConnectionClick"/>
            </Grid>
        </Border>

        <!-- Log Output -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="8">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                     Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Actions Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Скопировать всё" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" FontSize="11" Margin="0,0,8,0" Click="OnCopyClick"/>
            <Button Content="Сохранить в .txt" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" FontSize="11" Margin="0,0,8,0" Click="OnSaveClick"/>
            <Button Content="Очистить" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" FontSize="11" Click="OnClearClick"/>
        </StackPanel>
    </Grid>
</Window>
