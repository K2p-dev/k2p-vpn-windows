<Window x:Class="K2pVpnWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:K2pVpnWindows.Views"
        Title="Как 2 пальца" Width="440" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="/Assets/logo.png" Width="26" Height="26" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Как 2 пальца" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource CardVariantBrush}" BorderBrush="{StaticResource OutlineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Subscription Pill -->
                <Border x:Name="StatusBadge" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="9,4" Margin="0,0,8,0">
                    <TextBlock x:Name="StatusBadgeText" Text="Активна • — дн." FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentHoverBrush}" TextWrapping="NoWrap"/>
                </Border>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="—" Width="30" Height="30" Click="OnMinimizeClick"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    <Button Content="✕" Width="30" Height="30" Click="OnCloseClick"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderThickness="0" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Navigation Bar (Visible when authenticated) -->
            <Border x:Name="NavBar" Grid.Row="1" Visibility="Collapsed"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="4" Margin="20,0,20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NavMainBtn" Grid.Column="0" Content="VPN" Click="OnNavMainClick"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="8,7" FontSize="12"/>
                    <Button x:Name="NavTariffsBtn" Grid.Column="1" Content="Тарифы" Click="OnNavTariffsClick"
                            Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,7" FontSize="12"/>
                    <Button x:Name="NavSettingsBtn" Grid.Column="2" Content="Настройки" Click="OnNavSettingsClick"
                            Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,7" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Active Screen Host -->
            <Grid Grid.Row="2">
                <views:AuthView x:Name="AuthScreen" Visibility="Visible"/>
                <views:MainView x:Name="MainScreen" Visibility="Collapsed"/>
                <views:TariffsView x:Name="TariffsScreen" Visibility="Collapsed"/>
                <views:SettingsView x:Name="SettingsScreen" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
