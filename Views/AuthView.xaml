<UserControl x:Class="K2pVpnWindows.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,12,22,22">
            <!-- Brand Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,12,0,22">
                <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="54" Height="54" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Как 2 пальца" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,2"/>
                <TextBlock Text="Два движения. Ноль проблем." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Mode Tabs -->
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource OutlineBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabTgBtn" Grid.Column="0" Content="Telegram" Click="OnTabTgClick"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="8,8" FontSize="12"/>
                    <Button x:Name="TabTokenBtn" Grid.Column="1" Content="Токен / URL" Click="OnTabTokenClick"
                            Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,8" FontSize="12"/>
                    <Button x:Name="TabEmailBtn" Grid.Column="2" Content="Email" Click="OnTabEmailClick"
                            Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="8,8" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Telegram Auth Panel -->
            <Border x:Name="TgPanel" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Быстрый вход через Telegram" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Нажмите кнопку ниже — откроется бот @easyforeasy_bot. Нажмите Start в боте, и приложение автоматически выполнит вход."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <Button x:Name="TgLoginBtn" Content="Войти через @easyforeasy_bot"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OnTgLoginClick"/>
                    <TextBlock x:Name="TgPollingText" Visibility="Collapsed" Text="Ожидание подтверждения в Telegram..."
                               FontSize="12" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Token / Subscription URL Panel -->
            <Border x:Name="TokenPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Вход по токену или ссылке подписки" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Вставьте токен авторизации из бота @easyforeasy_bot или прямую ссылку подписки (https://...)."
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <TextBox x:Name="TokenBox" Style="{StaticResource DarkTextBoxStyle}" Height="42" Margin="0,0,0,14"/>
                    <Button x:Name="TokenLoginBtn" Content="Продолжить" Style="{StaticResource PrimaryButtonStyle}" Click="OnTokenLoginClick"/>
                </StackPanel>
            </Border>

            <!-- Email Auth Panel -->
            <Border x:Name="EmailPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Вход по Email" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource DarkTextBoxStyle}" Height="40" Margin="0,0,0,10"/>
                    <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBoxStyle}" Height="40" Margin="0,0,0,14"/>
                    <Button x:Name="EmailLoginBtn" Content="Войти" Style="{StaticResource PrimaryButtonStyle}" Click="OnEmailLoginClick"/>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#3B111C" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Foreground="#FCA5A5"/>
            </Border>

            <!-- Footer Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Telegram-бот" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"
                        Click="OnOpenBotClick"/>
                <Button Content="Поддержка" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7"
                        Click="OnOpenSupportClick"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
